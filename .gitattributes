# Normalize repository text to LF.
* text=auto eol=lf

# Keep Windows command scripts compatible with cmd.exe.
*.bat text eol=crlf
*.cmd text eol=crlf

# Explicit binary formats.
*.7z binary
*.aar binary
*.aab binary
*.apk binary
*.ap_ binary
*.class binary
*.dex binary
*.gif binary
*.gz binary
*.ico binary
*.jar binary
*.jpeg binary
*.jpg binary
*.jks binary
*.keystore binary
*.p12 binary
*.pfx binary
*.pdf binary
*.png binary
*.so binary
*.ttf binary
*.webp binary
*.woff binary
*.woff2 binary
*.zip binary
