<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/kit_test_manual_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusableInTouchMode="true"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="@string/kit_test_manual_app_name"
            android:textColor="#17221B"
            android:textSize="24sp"
            android:textStyle="bold" />

        <include layout="@layout/kit_test_line_manual" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:labelFor="@id/kit_test_manual_numeric"
            android:text="@string/kit_test_manual_numeric_label"
            android:textColor="#344139"
            android:textSize="16sp" />

        <com.whisper.kit.widget.KitCodeInputEditText
            android:id="@+id/kit_test_manual_numeric"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:background="@null"
            android:digits="0123456789"
            android:imeOptions="actionNext"
            android:inputType="number"
            android:maxLength="6"
            android:padding="0dp"
            android:singleLine="true"
            android:textColor="#17221B"
            android:textSize="24sp"
            app:kitCodeItemBackground="@drawable/kit_test_code_item_background"
            app:kitCodeItemHeight="52dp"
            app:kitCodeItemWidth="40dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:labelFor="@id/kit_test_manual_ascii"
            android:text="@string/kit_test_manual_ascii_label"
            android:textColor="#344139"
            android:textSize="16sp" />

        <com.whisper.kit.widget.KitCodeInputEditText
            android:id="@+id/kit_test_manual_ascii"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:background="@null"
            android:digits="0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
            android:imeOptions="actionDone"
            android:inputType="textVisiblePassword"
            android:maxLength="6"
            android:padding="0dp"
            android:singleLine="true"
            android:textColor="#17221B"
            android:textSize="24sp"
            app:kitCodeItemBackground="@drawable/kit_test_code_item_background"
            app:kitCodeItemHeight="52dp"
            app:kitCodeItemWidth="40dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/kit_test_manual_clear"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/kit_test_manual_clear" />

            <Button
                android:id="@+id/kit_test_manual_done"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/kit_test_manual_done" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
