<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="oval">
            <size android:width="32dp" android:height="32dp" />
            <solid android:color="#E2E5E7" />
            <stroke android:width="2dp" android:color="#A3ACB2" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <size android:width="32dp" android:height="32dp" />
            <solid android:color="#26885A" />
            <stroke android:width="2dp" android:color="#176C43" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="oval">
            <size android:width="32dp" android:height="32dp" />
            <solid android:color="#FFFFFF" />
            <stroke android:width="3dp" android:color="#2262B0" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <size android:width="32dp" android:height="32dp" />
            <solid android:color="#FFFFFF" />
            <stroke android:width="2dp" android:color="#26885A" />
        </shape>
    </item>
</selector>
